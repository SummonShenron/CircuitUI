# MongoDB Atlas connection string for CircUIt's own app/screen documents.
MONGO_URI=
MONGO_DATABASE=circuitui
LOG_LEVEL=INFO
CORS_ORIGINS=["http://127.0.0.1:8091"]

# Base URL (including /api) of the Circuit workflow_builder backend that
# published apps call into. Point this at a local instance
# (http://127.0.0.1:8010/api) or a deployed one.
WORKFLOW_BUILDER_API_URL=http://127.0.0.1:8010/api

# Clerk must be the SAME application/instance used by workflow_builder so a
# bearer token minted here is also valid there.
DEV_USER_ID=local-dev-user
CLERK_ISSUER=
VITE_CLERK_PUBLISHABLE_KEY=

# Read by the frontend (Vite) to reach this backend.
VITE_CIRCUITUI_API_URL=http://127.0.0.1:8020/api
